        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏବେ କ’ଣ ଚାଲୁ ଅଛି ଓ ପରେ କ’ଣ ଅଛି, ଦେଖନ୍ତୁ।"
