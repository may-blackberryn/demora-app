    "See what's on now and what's next.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was gerade aktiv ist und was als Nächstes kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what's on now and what's next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve qué está activo ahora y qué viene después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qui est actif et ce qui vient ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि अभी क्या सक्रिय है और आगे क्या होगा।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, co jest teraz aktywne i co będzie potem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que está ativo agora e o que vem a seguir."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an neyin etkin olduğunu ve sırada ne olduğunu görün."
          }
        }
      }
    },
    "Your next change and when it lands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
