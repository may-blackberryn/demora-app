        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હમણાં શું ચાલુ છે અને આગળ શું છે, જુઓ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראו מה פעיל עכשיו ומה הבא בתור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि अभी क्या सक्रिय है और आगे क्या होगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledaj što je sada aktivno i što slijedi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg, mi aktív most, és mi jön következőnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat apa yang aktif sekarang dan apa yang berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa è attivo adesso e cosa viene dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今の状態と、次の予定を確認できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ಏನು ಜಾರಿಯಲ್ಲಿದೆ ಮತ್ತು ಮುಂದೆ ಏನು ಎಂದು ನೋಡಿ."
