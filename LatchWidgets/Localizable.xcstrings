    "See what's on now and what's next.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على ما هو قيد التشغيل الآن وما يأتي بعده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন কী চালু আর এরপর কী, দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira què hi ha activat ara i què ve després."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, co platí teď a co přijde dál."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvad der gælder nu, og hvad der kommer næste gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was gerade aktiv ist und was als Nächstes kommt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δες τι ισχύει τώρα και τι έρχεται μετά."
