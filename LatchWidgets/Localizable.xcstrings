        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what's on now and what's next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve qué está activo ahora y qué viene después."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, mikä on voimassa nyt ja mitä tulee seuraavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce qui est actif et ce qui vient ensuite."
